# ===== EJEMPLO DE CONFIGURACIÓN =====
# Copia este archivo a .env.development o .env.production según tu entorno

# URLs del backend WebSocket
VITE_WS_TEXT_URL=ws://localhost:8000/ws/chat
VITE_WS_VOICE_URL=ws://localhost:8001/ws/voice

# Para producción en Azure, usa wss:// (WebSocket seguro):
# VITE_WS_TEXT_URL=wss://backend-text.YOUR-REGION.azurecontainerapps.io/ws/chat
# VITE_WS_VOICE_URL=wss://backend-voice.YOUR-REGION.azurecontainerapps.io/ws/voice
