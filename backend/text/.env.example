# ============================================
# Variables de Entorno - SIKA AI Assistant
# ============================================

# --- DESARROLLO LOCAL ---
# Copia este archivo a .env y configura tus valores

# --- Azure AI Configuration (REQUERIDO) ---
PROJECT_CONNECTION_STRING=your_azure_project_connection_string
AZURE_AGENT_ID=asst_your_agent_id
MODEL_DEPLOYMENT_NAME=gpt-4

# --- CORS Configuration ---
# Para desarrollo local
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Para Azure Container Apps (ejemplo)
# ALLOWED_ORIGINS=https://sika-frontend.azurewebsites.net,https://sika.com

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- Azure Container Apps (se configuran en Azure Portal) ---
# Estas variables las configuras en Azure, no en .env local:
# - ALLOWED_ORIGINS: URLs de tu frontend en Azure
# - ENVIRONMENT: production, staging, development
# - PORT: Azure lo establece automáticamente (usualmente 80 o 8000)

# Credenciales de Service Principal (necesarias para Docker)
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""